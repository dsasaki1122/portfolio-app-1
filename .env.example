# このファイルをコピーして .env を作成する
#   cp .env.example .env

# DB 接続文字列（本番: Aurora MySQL 8.0）
# 書式: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/gohan_note"

# S3 アップロード先（認証情報はAWS SDKのデフォルトプロバイダーチェーンに委ねる。
# 本番はECSタスクロール、ローカル開発は ~/.aws/credentials 等を利用）
AWS_REGION="ap-northeast-1"
S3_BUCKET_NAME="gohan-note-picture-bucket"
